# Select openai or azure. Restart the pipeline after changing settings.
LLM_PROVIDER=openai
# Optional: sent to the provider as a number. Leave blank for the model's default.
LLM_TEMPERATURE=

# Shared per-request limits for classification and engagement linking.
# Input is a local token estimate including prompts, data, and response schema.
LLM_MAX_INPUT_TOKENS=32000
# Output includes reasoning tokens where applicable. Incomplete JSON is rejected.
LLM_MAX_OUTPUT_TOKENS=2000

# Maximum matching engagement rows per incident, in ENG_ALL.csv order.
LINK_MAX_CANDIDATES=70

# Local OpenAI connection
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Azure connection: used only when LLM_PROVIDER=azure
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
# Use the token scope and API version approved for your Azure resource.
AZURE_OPENAI_TOKEN_SCOPE=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=
# This is a deployment name, which can differ from the underlying model name.
AZURE_OPENAI_DEPLOYMENT=gpt-5.1

# Optional corporate network settings
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
