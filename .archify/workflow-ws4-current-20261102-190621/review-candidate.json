  "cards": [
    {
      "dot": "cyan",
      "title": "Classification is the first gate",
      "items": [
        "Approve is available for successful HSBC or SUPPLIER. UNCERTAIN needs a definite correction to advance.",
        "Disagree requires a reason and a selected class. Failed processing can be corrected manually; pending processing cannot.",
        "Every classification save resets downstream reviews. Saving HSBC or UNCERTAIN clears the active proposal."
      ]
    },
    {
      "dot": "violet",
      "title": "Supplier decisions can rerun linking",
      "items": [
        "Approve accepts a usable original model Supplier name. Unknown or blank requires an exact catalog choice and reason.",
        "After changing HSBC/UNCERTAIN/failed to Supplier, choose a base name because there is no usable model Supplier name.",
        "A changed name is saved before the shared finder runs. Same-name approval reruns only missing proposals; failed/no-match results allow explicit retry.",
        "Every supplier decision resets engagement approval. A lookup failure preserves the supplier correction."
      ]
    },
    {
      "dot": "emerald",
      "title": "Human choice remains separate",
      "items": [
        "The model default is not human approval. The reviewer can inspect every Python match, including rows outside the LLM cap.",
        "A current catalog and saved classification/name decisions are required. Engagement decisions wait while finding is running.",
        "All Disagree decisions require reasons. None of these completes review but creates no accepted link.",
        "Saves check row versions and catalog freshness. Changing an engagement leaves classification and supplier decisions unchanged."
      ]
    }
  ]
