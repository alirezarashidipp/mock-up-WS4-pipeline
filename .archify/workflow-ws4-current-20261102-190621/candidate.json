  "cards": [
    {
      "dot": "cyan",
      "title": "One sequential LLM pipeline",
      "items": [
        "python -m app.llm.pipeline processes classification, then Supplier linking, then the next row.",
        "Classification is saved before linking. Every link result is saved before advancing.",
        "Automatic suggestions never wait for human approval. The default remains a proposal.",
        "Reruns resume unfinished classification or linking and skip incidents with human decisions."
      ]
    },
    {
      "dot": "violet",
      "title": "All matches ≠ model candidates ≠ suggestions",
      "items": [
        "Matching checks THIRD_PARTY_NAME first, then THIRD_PARTY_NORMALISED_NAME; each ENG_ALL row appears once.",
        "Normalization uses ASCII folding, lowercase and word spacing. Original source names stay unchanged.",
        "LINK_MAX_CANDIDATES defaults to 70. The first rows follow source order, not relevance rank. Zero candidates means no linking request.",
        "The model returns 0–5 supported suggestions. Its default has the highest evidence strength, 1–4, not a probability."
      ]
    },
    {
      "dot": "emerald",
      "title": "One output, one dashboard",
      "items": [
        "INCIDENTS.csv holds source facts, classification, link proposals, review decisions, row revision and selected ENG_* values.",
        "The incident dashboard on 127.0.0.1:8766 can read progress while the batch runs. Human review is shown in the companion diagram.",
        "Configured OpenAI or Azure calls use YAML instructions and strict structured output. This diagram is source-backed, not a live API execution trace."
      ]
    }
  ]
